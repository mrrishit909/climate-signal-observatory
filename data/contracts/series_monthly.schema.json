{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "baselines": {
   "items": {
    "enum": [
     "1850-1900",
     "1951-1980",
     "1991-2020"
    ]
   },
   "minItems": 3,
   "type": "array"
  },
  "n_months": {
   "minimum": 1000,
   "type": "integer"
  },
  "schema_version": {
   "const": "v1"
  },
  "series": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "ci_hi": {
      "anyOf": [
       {
        "additionalProperties": {
         "items": {
          "type": [
           "number",
           "null"
          ]
         },
         "type": "array"
        },
        "minProperties": 1,
        "propertyNames": {
         "enum": [
          "1850-1900",
          "1951-1980",
          "1991-2020"
         ]
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "ci_lo": {
      "anyOf": [
       {
        "additionalProperties": {
         "items": {
          "type": [
           "number",
           "null"
          ]
         },
         "type": "array"
        },
        "minProperties": 1,
        "propertyNames": {
         "enum": [
          "1850-1900",
          "1951-1980",
          "1991-2020"
         ]
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "native_baseline": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "values": {
      "additionalProperties": {
       "items": {
        "type": [
         "number",
         "null"
        ]
       },
       "type": "array"
      },
      "minProperties": 1,
      "propertyNames": {
       "enum": [
        "1850-1900",
        "1951-1980",
        "1991-2020"
       ]
      },
      "type": "object"
     }
    },
    "required": [
     "id",
     "label",
     "source",
     "native_baseline",
     "values",
     "ci_lo",
     "ci_hi"
    ],
    "type": "object"
   },
   "minItems": 2,
   "type": "array"
  },
  "start": {
   "pattern": "^[0-9]{4}-[0-9]{2}$",
   "type": "string"
  },
  "tags": {
   "additionalProperties": {
    "pattern": "^(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC)(/(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC))*$",
    "type": "string"
   },
   "minProperties": 1,
   "type": "object"
  }
 },
 "required": [
  "schema_version",
  "tags",
  "start",
  "n_months",
  "baselines",
  "series"
 ],
 "title": "series_monthly",
 "type": "object"
}
