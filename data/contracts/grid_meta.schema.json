     "type": "integer"
    }
   },
   "required": [
    "annual_rule",
    "min_months_per_cell_year"
   ],
   "type": "object"
  },
  "baseline_offsets": {
   "additionalProperties": {
    "additionalProperties": false,
    "properties": {
     "min_reference_share": {
      "type": "number"
     },
     "n_valid_cells": {
      "type": "integer"
     },
     "unit_degC_per_unit": {
      "type": "number"
     },
     "values": {
      "items": {
       "type": [
        "integer",
        "null"
       ]
      },
      "type": "array"
     }
    },
    "required": [
     "unit_degC_per_unit",
     "min_reference_share",
     "n_valid_cells",
     "values"
    ],
    "type": "object"
   },
   "minProperties": 1,
   "propertyNames": {
    "enum": [
     "1850-1900",
     "1951-1980",
     "1991-2020"
    ]
   },
   "type": "object"
  },
  "encoding": {
   "additionalProperties": false,
   "properties": {
    "compression": {
     "const": "gzip"
    },
    "decode": {
     "type": "string"
    },
    "dtype": {
     "const": "int8"
    },
    "file": {
     "type": "string"
    },
    "gz_bytes": {
     "type": "integer"
    },
    "layout": {
     "type": "string"
    },
    "lon_order": {
     "const": "west_to_east"
    },
    "missing_value": {
     "const": -128
    },
    "row_order": {
     "const": "north_to_south"
    },
    "scale_degC_per_unit": {
     "type": "number"
    },
    "sha256_uncompressed": {
     "type": "string"
    },
    "uncompressed_bytes": {
     "type": "integer"
    },
    "valid_range": {
     "items": {
      "type": "integer"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    }
   },
   "required": [
    "dtype",
    "scale_degC_per_unit",
    "missing_value",
    "valid_range",
    "layout",
    "row_order",
    "lon_order",
    "file",
    "compression",
    "uncompressed_bytes",
    "gz_bytes",
    "sha256_uncompressed",
    "decode"
   ],
   "type": "object"
  },
  "grid": {
   "additionalProperties": false,
   "properties": {
    "lat_first_center": {
     "type": "number"
    },
    "lat_step_deg": {
     "type": "number"
    },
    "lon_first_center": {
     "type": "number"
    },
    "lon_step_deg": {
     "type": "number"
    },
    "n_lat": {
     "type": "integer"
    },
    "n_lon": {
     "type": "integer"
    }
   },
