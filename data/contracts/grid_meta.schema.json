    "type": "integer"
   },
   "type": "array"
  },
  "years": {
   "additionalProperties": false,
   "properties": {
    "first": {
     "type": "integer"
    },
    "last": {
     "type": "integer"
    },
    "n": {
     "type": "integer"
    }
   },
   "required": [
    "first",
    "last",
    "n"
   ],
   "type": "object"
  }
 },
 "required": [
  "schema_version",
  "tags",
  "id",
  "source",
  "product",
  "native_baseline",
  "units",
  "encoding",
  "grid",
  "years",
  "aggregation",
  "valid_cells_per_year",
  "valid_area_share_per_year",
  "baseline_offsets",
  "quantization"
