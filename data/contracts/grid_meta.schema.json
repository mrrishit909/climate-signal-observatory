    "n_lat",
    "n_lon",
    "lat_step_deg",
    "lon_step_deg",
    "lat_first_center",
    "lon_first_center"
   ],
   "type": "object"
  },
  "id": {
   "type": "string"
  },
  "native_baseline": {
   "type": "string"
  },
  "product": {
   "type": "string"
  },
  "quantization": {
   "additionalProperties": false,
